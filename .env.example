# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: groq | ollama | openai
LLM_PROVIDER=groq

# Groq (free tier) — get key at console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (local, fully offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (optional)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ── TTS Provider ──────────────────────────────────────────────────────────────
# Options: edge_tts (free) | elevenlabs
TTS_PROVIDER=edge_tts
ELEVENLABS_API_KEY=

# ── Image Generation ──────────────────────────────────────────────────────────
# Options: local (PIL, always works) | huggingface (free tier) | dalle
IMAGE_PROVIDER=local
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ── Video Settings ────────────────────────────────────────────────────────────
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24

# ── Deployment ────────────────────────────────────────────────────────────────
PORT=8000
